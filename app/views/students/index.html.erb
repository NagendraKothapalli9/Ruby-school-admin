<div class="container-fluid bg-dark justify-content-center text-white pt-5 vh-100">

  <h2 class="text-center">Students Details</h2>

  <div class="float-end text-center mx-5 ">
    <%= link_to 'Add Student', new_student_path,
        class: "btn btn-white text-white bg-success" %>
  </div>

  <div class="table-responsive mt-5" style="max-height: 385px; ">

    <table class="table table-striped table-hover table-bordered text-center position-relative">

      <thead class="position-sticky top-0">
        <tr>
          <th scope="col">Id</th>
          <th>Name</th>
          <th>Email</th>
          <th>Age</th>
          <th>Course</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <% @students.each do |student| %>
          <tr>
            <th scope="row"><%= student.id %></th>
            <td><%= student.name %></td>
            <td><%= student.email %></td>
            <td><%= student.age %></td>
            <td><%= student.course %></td>

            <td class="justify-content-evenly d-flex">

              <%= link_to student,
                  class: "btn btn-outline-primary btn-sm",
                  title: "View" do %>
                <i class="fa-solid fa-eye"></i>
              <% end %>

              <%= link_to edit_student_path(student),
                  class: "btn btn-outline-success btn-sm",
                  title: "Edit" do %>
                <i class="fa-solid fa-pen-to-square"></i>
              <% end %>

              <%= link_to student,
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: 'You Want to Delete this Student?'
                  },
                  class: "btn btn-outline-danger btn-sm",
                  title: "Delete" do %>
                <i class="fa-solid fa-trash-can"></i>
              <% end %>

            </td>
          </tr>
        <% end %>
      </tbody>

    </table>

  </div>

</div>