
<%= form_with model: @student, local: true do |form| %>

<%if @student.errors.any? %>
<% @student.errors.full_messages.each do |message| %>
  <p class="text-danger text-center"><%= message %></p>
<% end %>
<% end %>

  <div class="form-group pt-3 ps-5 fs-5 text-white text-center">
   

  <div class= "mt-3">
    <%= form.label :name  %>
    <%= form.text_field :name, class: " ms-2" %>
  </div>

  <div class= "mt-3">
    <%= form.label :email %>
    <%= form.email_field :email, class: " ms-2" %>
  </div>

  <div class= "mt-3">
    <%= form.label :age  %>
    <%= form.number_field :age, class: " ms-4" %>
  </div>

  <div class= "mt-3">
    <%= form.label :course  %>
    <%= form.text_field :course, class: " ms-0" %>
  </div>

  <div>
    <%= form.submit "Create Student" , class: "btn btn-white bg-success text-white mt-5 " %>
  </div>
  </div>
<% end %>   
